# Golden files are byte exact fixtures, and some of them carry the line endings
# they exist to test. Git rewrites line endings on checkout on Windows, which
# would turn a fixture into a different document than the one that was recorded,
# so these are checked out exactly as they were committed.
normalize/testdata/*.in  -text
normalize/testdata/*.out -text

# The legacy fixtures are the strongest form of this. A .bytes file is not text
# in any encoding git knows, it is the input to the stage that decides what
# encoding it is in, and VISCII alone puts six letters below 0x80. Rewriting a
# byte of one of these changes the document rather than the way it is stored.
normalize/testdata/legacy/*.bytes -text
normalize/testdata/legacy/*.txt   -text
normalize/testdata/legacy/*.iconv -text

# The coverage set carries copies of three of those legacy fixtures, and a test
# checks each copy against what it was copied from. A copy checked out with
# different line endings than its original is a copy that has drifted, which is
# what the test is there to catch and not something a checkout should cause.
count/testdata/coverage/*.txt -text

# The labeled set is measured, and a measurement that reports one recall on one
# platform and another somewhere else is not a measurement. Its line endings are
# part of the document, so they are checked out as they were committed. The
# detectors are held to reading either ending by a test rather than by this.
cover/testdata/recall/*.txt -text

# SCHEMA.md is generated by `gao store schema -md`, and a test compares the file
# in the repository against what the generator produces right now. Line endings
# rewritten on checkout would fail that test on Windows and nowhere else, which
# is a report about git rather than about the schema.
SCHEMA.md -text
